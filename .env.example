# Model: ollama (default, local) | openai | anthropic | fake (offline tests)
LLM_PROVIDER=ollama
# LLM_MODEL=qwen3:8b             # defaults: ollama qwen3:8b, openai gpt-4o-mini, anthropic claude-sonnet-5-5
OLLAMA_BASE_URL=http://localhost:11434
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Search: any of tavily, wikipedia, arxiv, fake (comma-separated).
# Default: tavily if TAVILY_API_KEY is set, otherwise wikipedia,arxiv (no keys needed).
# SEARCH_PROVIDERS=wikipedia,arxiv
# TAVILY_API_KEY=
# RESULTS_PER_QUERY=4

# Workflow
# MAX_SUB_QUESTIONS=4
# MAX_ROUNDS=2                   # critique -> follow-up research -> revise, at most this many times
# QUALITY_BAR=8                  # stop revising once the critic scores >= this (1-10)
# APPROVE_PLAN=0                 # 1 = pause after planning for human approval
# CHECKPOINT_DB=data/checkpoints.sqlite

# Evaluation judge (default: the model under test; a stronger, different model is better)
# JUDGE_PROVIDER=openai
# JUDGE_MODEL=gpt-4o

# Optional Langfuse tracing
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
